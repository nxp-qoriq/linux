#include "imx93-11x11-evk-flexspi-m2.dts"

&lpi2c5 {
#address-cells = <1>;
#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	pinctrl-1 = <&pinctrl_lpi2c5>;
	status = "okay";

	sensor@48 {
		compatible = "nxp,pct2075";
		reg = <0x48>;
	};
};

&lpuart7 { /* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>;
	status = "okay";
};

&lpuart8 { /* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart8>;
	status = "okay";
};

&iomuxc {

pinctrl_lpi2c5: lpi2c5grp {
			fsl,pins = <
				MX93_PAD_GPIO_IO00__LPI2C5_SDA			0x40000b9e
				MX93_PAD_GPIO_IO01__LPI2C5_SCL			0x40000b9e
				>;
		};

pinctrl_uart7: uart7grp {
		       fsl,pins = <
			       MX93_PAD_GPIO_IO08__LPUART7_TX			0x31e
			       MX93_PAD_GPIO_IO09__LPUART7_RX			0x31e
			       >;
	       };

pinctrl_uart8: uart8grp {
		       fsl,pins = <
			       MX93_PAD_GPIO_IO12__LPUART8_TX			0x31e
			       MX93_PAD_GPIO_IO13__LPUART8_RX			0x31e
			       >;
	       };
};

&flexspi1 {
        flash0: flash@0 {
                partitions {
                        compatible = "fixed-partitions";
                        #address-cells = <1>;
                        #size-cells = <1>;

                        partition@0 {
                                label = "boot";
                                reg = <0x00000000 0x002C0000>;
                        };

                        partition@2C0000 {
                                label = "kernel";
                                reg = <0x002C0000 0x01000000>;
                        };

                        partition@12C0000 {
                                label = "dtb";
                                reg = <0x012C0000 0x00080000>;
                        };

                        partition@1340000 {
                                label = "rootfs";
                                reg = <0x01340000 0x027C0000>;
                        };
                };
        };
};
