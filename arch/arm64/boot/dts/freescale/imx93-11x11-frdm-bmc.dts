#include "imx93-11x11-frdm.dts"

&lpspi3 {
	status = "disabled";
};

&tpm3 {
	status = "disabled";
};

&tpm4 {
	status = "disabled";
};


&lpuart7 { /* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>;
	status = "okay";
};

&lpuart8 { /* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart8>;
	status = "okay";
};


/* Force USB device (peripheral) mode for OpenBMC */
&usbotg1 {
        dr_mode = "peripheral";
        status = "okay";
};

&iomuxc {

pinctrl_lpi2c5: lpi2c5grp {
			fsl,pins = <
				MX93_PAD_GPIO_IO00__LPI2C5_SDA			0x40000b9e
				MX93_PAD_GPIO_IO01__LPI2C5_SCL			0x40000b9e
				>;
		};

pinctrl_uart7: uart7grp {
		       fsl,pins = <
			       MX93_PAD_GPIO_IO08__LPUART7_TX			0x31e
			       MX93_PAD_GPIO_IO09__LPUART7_RX			0x31e
			       >;
	       };

pinctrl_uart8: uart8grp {
		       fsl,pins = <
			       MX93_PAD_GPIO_IO12__LPUART8_TX			0x31e
			       MX93_PAD_GPIO_IO13__LPUART8_RX			0x31e
			       >;
	       };

};

&lpi2c5 {
#address-cells = <1>;
#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	pinctrl-1 = <&pinctrl_lpi2c5>;
	status = "okay";

	pca9451@25 {
		compatible = "nxp,pca9451";
		reg = <0x25>;
		status = "okay";
	};

	sensor11@11 {
		compatible = "microchip,pac1934";
	        reg = <0x11>;
	        status = "okay";
	};

	sensor12@12 {
		compatible = "microchip,pac1934";
	        reg = <0x12>;
	        status = "okay";
	};

	sensor13@13 {
		compatible = "microchip,pac1934";
	        reg = <0x13>;
	        status = "okay";
	};

	sensor14@14 {
		compatible = "microchip,pac1934";
	        reg = <0x14>;
	        status = "okay";
	};

	sensor15@15 {
		compatible = "microchip,pac1934";
	        reg = <0x15>;
	        status = "okay";
	};

	sensor16@16 {
		compatible = "microchip,pac1934";
	        reg = <0x16>;
	        status = "okay";
	};

	sensor34@34 {
		compatible = "microchip,pac1934";
	        reg = <0x34>;
	        status = "okay";
	};

	sensor@48 {
		compatible = "nxp,pct2075";
		reg = <0x48>;
	        #thermal-sensor-cells = <0>;   /* Required for thermal framework */
	};

};

&lpi2c1 {
	p3t2030@72 {
		compatible = "ti,tmp108";
		reg = <0x72>;
	};
};
