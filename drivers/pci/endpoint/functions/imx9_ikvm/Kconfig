# PCI Endpoint KVM input
#

config PCIE_KVM_INPUT
	tristate "PCIe EP capture HID input from remote and local input device (iKVM)"
	depends on PCI_EPF_IMX9_VGA
	depends on HID
	default y
	help
	  Say Y or M here to expose the i.MX9 PCIe endpoint HID device
	  for OpenBMC iKVM.

	  This driver reads HID data from the HID ring buffer and writes it to endpoint BAR3.

	  Requires CONFIG_PCI_EPF_IMX9_VGA=y or =m.

